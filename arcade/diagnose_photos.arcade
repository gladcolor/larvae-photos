// ---------------------------------------------------------------------------
// DIAGNOSTIC: why does the popup say "No photos for this site yet"?
//
// Run this on a site you KNOW has photos, then delete the expression.
//
// Reading the result:
//
//   "url fields: 0"
//       The layer has no photo URL fields. It was published from an old
//       GeoPackage, before the URL columns were populated, and ArcGIS Online
//       drops columns that are entirely null. Re-publish from the current
//       GeoPackage (output/epicollect5_test.gpkg).
//
//   Fields listed, every value "(empty)"
//       Either the layer is stale, or Expects() is missing from the expression
//       you are debugging. Without Expects(), dynamically discovered attributes
//       are never requested and every value reads as empty.
//
//   Fields listed with URLs
//       Data and access are both fine. The site you tested simply has blank
//       photo questions, which is normal: about 120 of 2370 cells are blank.
//
// NOTE ON ACCESSORS: fields are read with $feature[name]. Attribute($feature,
// name) does NOT exist in the pop-up profile and fails to compile with
// "Function not found".
// ---------------------------------------------------------------------------

Expects($feature, "*")

var urlFields = [];
for (var i in Schema($feature).fields) {
    var fieldName = Schema($feature).fields[i].name;
    if (Right(Lower(fieldName), 4) == "_url") {
        urlFields[Count(urlFields)] = fieldName;
    }
}

var report = "url fields: " + Count(urlFields) + "<br />";
report += "total fields in layer: " + Count(Schema($feature).fields) + "<br /><br />";

if (Count(urlFields) == 0) {
    report += "<b>No field ends in _url. The layer has:</b><br />";
    for (var n in Schema($feature).fields) {
        report += Schema($feature).fields[n].name + "<br />";
    }
    return { "type": "text", "text": report };
}

for (var j in urlFields) {
    var name = urlFields[j];
    var value = $feature[name];
    report += "<b>" + name + "</b><br />&nbsp;&nbsp;"
            + IIf(IsEmpty(value), "(empty)", Left(value, 60)) + "<br /><br />";
}

return { "type": "text", "text": report };
