// ---------------------------------------------------------------------------
// First available photo URL - Semera / Logiya larval habitat layer
//
// Returns a single URL, for use as the source of a popup **Image** media
// element. Returns "" when the site has no published photo, which makes ArcGIS
// Online hide the image instead of showing a broken one.
//
// HOW TO USE
//   1. Configure pop-ups -> Add content -> Image
//   2. Next to "URL" click the {} / fx button -> New expression
//   3. Paste this file, name it "firstPhoto", click Done
//   4. Set the image URL to  {expression/expr0}
//
// To pin a specific view instead, use the field directly and skip Arcade
// entirely, e.g. set the Image URL to  {f_8_North_url}
// ---------------------------------------------------------------------------

var candidates = [
    $feature.f_6_Surrounding_url,
    $feature.f_7_Down_entire_water_url,
    $feature.f_8_North_url,
    $feature.f_9_South_url,
    $feature.f_10_East_url,
    $feature.f_11_West_url
];

for (var i in candidates) {
    if (!IsEmpty(candidates[i])) {
        return candidates[i];
    }
}

return "";
