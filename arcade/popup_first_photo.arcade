// ---------------------------------------------------------------------------
// First available photo URL - Semera / Logiya larval habitat layer
//
// Returns a single URL string, for the source of a popup **Image** media element.
// Returns "" when the site has no published photo, which makes ArcGIS Online hide
// the image rather than show a broken one.
//
// No field name is hardcoded: it takes the first field ending in "_url" that has a
// value, so it survives the question renames and reorderings that shift every
// Epicollect5 column name.
//
// HOW TO USE
//   1. Configure pop-ups -> Add content -> Image
//   2. Next to "URL" click the {} / fx button -> New expression
//   3. Paste this file, name it "firstPhoto", click Done
//   4. Set the image URL to  {expression/expr0}
//
// To pin one specific view, skip Arcade and set the Image URL to that field
// directly, e.g. {f_8_North_url} - but re-check the name after any form edit.
// ---------------------------------------------------------------------------

for (var i in Schema($feature).fields) {
    var fieldName = Schema($feature).fields[i].name;
    if (Right(Lower(fieldName), 4) == "_url") {
        var url = Attribute($feature, fieldName);
        if (!IsEmpty(url)) {
            return url;
        }
    }
}

return "";
