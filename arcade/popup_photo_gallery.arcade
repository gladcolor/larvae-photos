// ---------------------------------------------------------------------------
// Popup photo gallery - Semera / Logiya larval habitat layer
//
// Shows every published photo for the clicked site, and skips any photo that has
// not been published yet so the popup never renders a broken image.
//
// NO FIELD NAME IS HARDCODED. Epicollect5 builds column names from question
// ORDER, so adding or reordering a question renames every column after it. On
// 2026-08-06 two questions were renamed and two were swapped: "9_South" became
// "9_East" and "10_East" became "10_South". Anything pinned to a literal name
// would have shown the wrong label, or nothing at all. This expression instead
// finds every field ending in "_url" and derives its label from the field name,
// so the popup keeps working across form edits.
//
// HOW TO USE
//   1. Hosted feature layer item -> Visualization -> Configure pop-ups
//   2. Add content -> **Arcade**            <- not "Text"
//   3. Paste this whole file, name it "photoGallery", click Done
//
//   This returns a pop-up ELEMENT ({ "type": "text", "text": ... }), which is what
//   the Arcade content element expects. A Text element wants a plain string and
//   would show "[object Object]".
// ---------------------------------------------------------------------------

// REQUIRED. This expression finds its fields dynamically, via Schema(), so the
// client cannot tell in advance which attributes the popup needs. Without
// Expects() those attributes are never requested and every value reads as empty,
// which shows up as "No photos" on every single site. The wildcard asks for all
// fields; that is fine for a popup, which already fetches the whole feature.
Expects($feature, "*")

// Collect every "<question>_url" field the layer has, in field order.
var urlFields = [];
for (var i in Schema($feature).fields) {
    var fieldName = Schema($feature).fields[i].name;
    if (Right(Lower(fieldName), 4) == "_url") {
        urlFields[Count(urlFields)] = fieldName;
    }
}

// "f_10_South_url" -> "South";  "f_7_Down_close_up_wate_url" -> "Down close up wate"
function prettify(fieldName) {
    var stem = Left(fieldName, Count(fieldName) - 4);   // drop "_url"
    var parts = Split(stem, "_");
    var words = [];
    for (var k in parts) {
        var part = parts[k];
        // Skip the leading "f" and the question number that Epicollect5 prefixes.
        if (part == "" || part == "f") { continue; }
        if (Count(words) == 0 && IsEmpty(Number(part)) == false) { continue; }
        words[Count(words)] = part;
    }
    if (Count(words) == 0) { return stem; }
    return Concatenate(words, " ");
}

var html = "";
var shown = 0;

for (var j in urlFields) {
    var url = Attribute($feature, urlFields[j]);
    if (IsEmpty(url)) { continue; }

    html += "<p style='margin:0 0 12px 0;'>";
    html += "<b>" + prettify(urlFields[j]) + "</b><br />";
    html += "<a href='" + url + "' target='_blank'>";
    html += "<img src='" + url + "' style='width:100%; max-width:420px; border-radius:4px;' />";
    html += "</a></p>";
    shown++;
}

if (shown == 0) {
    if (Count(urlFields) == 0) {
        // A configuration problem, not a data problem, so say which it is.
        html = "<p><i>This layer has no photo URL fields. Re-publish it from a "
             + "GeoPackage produced by download_epicollect5.ipynb.</i></p>";
    } else {
        html = "<p><i>No photos published for this site yet.</i></p>";
    }
}

// Console() prints to the expression editor while testing; no effect once published.
Console(html);

return { "type": "text", "text": html };
