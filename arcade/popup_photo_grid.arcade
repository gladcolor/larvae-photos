// ---------------------------------------------------------------------------
// Compact 2-column photo grid - Semera / Logiya larval habitat layer
//
// Six stacked photos make a popup you have to scroll for a long time. This lays
// them out two per row in a table and puts the whole thing inside a collapsible
// <details> block, so the popup opens short and expands on demand.
//
// Every tag used here is on the ArcGIS Online sanitiser allowlist:
//   table tr td b br a img details summary div  + inline style
// Tags that are NOT allowed and get stripped: iframe, script, <style>, form,
// and any event handler such as onclick.
//
// HOW TO USE
//   Configure pop-ups -> Add content -> **Arcade**   (not "Text")
//   No field name is hardcoded, so this survives Epicollect5 form edits.
//   Paste, name it "photoGrid", click Done.
//   This returns a pop-up ELEMENT, which is what the Arcade content element
//   expects. A Text element wants a plain string instead and would show
//   "[object Object]".
// ---------------------------------------------------------------------------

// No field name is hardcoded: Epicollect5 renames columns whenever questions are
// reordered (on 2026-08-06 "9_South" became "9_East"), so the photo fields are
// discovered from the layer and labelled from the field name.
var urlFields = [];
for (var i in Schema($feature).fields) {
    var fieldName = Schema($feature).fields[i].name;
    if (Right(Lower(fieldName), 4) == "_url") {
        urlFields[Count(urlFields)] = fieldName;
    }
}

function prettify(fieldName) {
    var stem = Left(fieldName, Count(fieldName) - 4);
    var parts = Split(stem, "_");
    var words = [];
    for (var k in parts) {
        var part = parts[k];
        if (part == "" || part == "f") { continue; }
        if (Count(words) == 0 && IsEmpty(Number(part)) == false) { continue; }
        words[Count(words)] = part;
    }
    if (Count(words) == 0) { return stem; }
    return Concatenate(words, " ");
}

var cells = [];
for (var j in urlFields) {
    var url = Attribute($feature, urlFields[j]);
    if (IsEmpty(url)) { continue; }

    var cell = "<td style='width:50%; padding:3px; vertical-align:top;'>" +
               "<a href='" + url + "' target='_blank'>" +
               "<img src='" + url + "' style='width:100%; border-radius:3px;' />" +
               "</a>" +
               "<div style='font-size:11px; text-align:center;'>" + prettify(urlFields[j]) +
               "</div></td>";
    cells[Count(cells)] = cell;
}

if (Count(cells) == 0) {
    var empty = "<p><i>No photos for this site yet.</i></p>";
    if (Count(urlFields) == 0) {
        empty = "<p><i>This layer has no photo URL fields. Re-publish it from a "
              + "GeoPackage produced by download_epicollect5.ipynb.</i></p>";
    }
    Console(empty);
    return { "type": "text", "text": empty };
}

// Two cells per row.
var rows = "";
for (var k = 0; k < Count(cells); k += 2) {
    var second = "<td style='width:50%;'></td>";
    if (k + 1 < Count(cells)) { second = cells[k + 1]; }
    rows += "<tr>" + cells[k] + second + "</tr>";
}

var table = "<table style='width:100%; border-collapse:collapse;'>" + rows + "</table>";

// Open by default. Change <details open> to <details> to start collapsed.
var html = "<details open><summary style='cursor:pointer;'><b>Photos (" +
           Count(cells) + ")</b></summary>" + table + "</details>";

Console(html);
return { "type": "text", "text": html };
